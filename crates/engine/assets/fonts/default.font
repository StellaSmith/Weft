# Each row line lists the characters of one atlas row, left to right.
cell = 8 8
row = ABCDEFGHIJKLMNOP
row = QRSTUVWXYZabcdef
row = ghijklmnopqrstuv
row = wxyz0123456789!"
row = #$%&'()*+,-./:;<
row = =>?@[\]^_`{|}~«»
row = —–…°×·АБВГДЕЁЖЗИ
row = ЙКЛМНОПРСТУФХЦЧШ
row = ЩЪЫЬЭЮЯабвгдеёжз
row = ийклмнопрстуфхцч
row = шщъыьэюя
