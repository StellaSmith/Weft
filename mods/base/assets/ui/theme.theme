# Base game look. Resource packs can override any line.
default.text = #d8dceb
default.shadow = #1f1f2e
title.text = #ffffff
title.shadow = #1f1f2e
dim.text = #8d93ae
label.text = #d8dceb
panel.texture = base:gui/panel
panel.text = #d8dceb
panel.dim_text = #8d93ae
panel.shadow = #1f1f2e
well.texture = base:gui/well
well.text = #d8dceb
well.dim_text = #8d93ae
button.texture = base:gui/button
button.hover = base:gui/button_hover
button.pressed = base:gui/button_pressed
button.disabled = base:gui/button_disabled
button.text = #d8dceb
button.hover_text = #ffffff
button.shadow = #1f1f2e
button.disabled_text = #6b6f86
slider.track = base:gui/well
slider.knob = base:gui/button
slider.knob_hover = base:gui/button_hover
input.texture = base:gui/input
input.focused = base:gui/input_focused
input.text = #d8dceb
input.selection = #3a6ea8c0
tooltip.texture = base:gui/tooltip
sidebar.texture = base:gui/sidebar
news.texture = base:gui/tooltip
news.text = #d8dceb
tooltip.text = #d8dceb
background.texture = base:gui/background
background.color = #ffffff
overlay.fill = #0b0b14b0
scrollbar.track = base:gui/scrollbar_track
scrollbar.handle = base:gui/scrollbar_handle
scrollbar.handle_hover = base:gui/scrollbar_handle_hover
hearts.full = base:gui/heart_full
hearts.half = base:gui/heart_half
hearts.empty = base:gui/heart_empty
food.full = base:gui/food_full
food.half = base:gui/food_half
food.empty = base:gui/food_empty
armor.full = base:gui/armor_full
armor.half = base:gui/armor_half
armor.empty = base:gui/armor_empty
air.fill = #4080ff
arrow.background = base:gui/arrow_bg
arrow.fill_texture = base:gui/arrow_fill
flame.background = base:gui/flame_bg
flame.fill_texture = base:gui/flame_fill
slot.texture = base:gui/slot
slot.highlight = #8d93ae60
recipe_slot.texture = base:gui/slot
# The hotbar is part of the HUD and keeps its own look.
hotbar.fill = #8b8b8b
death.fill = #60000080
chat.text = #ffffff
chat.shadow = #202020
debug.text = #ffffff
debug.shadow = #202020
